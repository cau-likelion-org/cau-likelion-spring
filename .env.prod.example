# 이 파일을 복사해서 .env.prod로 만들고, EC2 서버(~/app/.env.prod)에 직접 올려두세요.
# GitHub에는 절대 커밋하지 마세요.
#
# 참고: 이 값들은 GitHub Secrets에 등록할 필요가 없습니다.
# GitHub Actions는 SSH로 EC2에 접속해서 "docker compose up -d"라는 명령만 실행하고,
# 그 명령이 참조하는 .env.prod는 EC2 서버 안에 이미 놓여있는 이 파일이기 때문입니다.
# GitHub Secrets에는 EC2 접속용 정보(EC2_HOST, EC2_SSH_KEY)만 등록하면 됩니다.

GITHUB_REPOSITORY_OWNER=cau-likelion-org

# RDS
RDS_HOST=your-db-instance.xxxxxxxxxx.ap-northeast-2.rds.amazonaws.com
RDS_PORT=3306
MYSQL_DATABASE=chunghaha
MYSQL_USER=chunghaha
MYSQL_PASSWORD=your_rds_password

# JWT
JWT_SECRET=your_jwt_secret_base64
JWT_ACCESS_EXPIRATION=1h
JWT_REFRESH_EXPIRATION=14d
JWT_SIGNUP_EXPIRATION=10m

# 구글 로그인
GOOGLE_CLIENT_ID=your_google_client_id

# 프론트 도메인 (CORS 허용 출처, 콤마로 여러 개 등록 가능)
FRONTEND_BASE_URL=https://내프론트도메인.한국,http://localhost:3000

# 메일 발송 (모집 알림)
MAIL_USERNAME=puang@likelion.org
MAIL_PASSWORD=

# FCM 푸시 알림
FIREBASE_CREDENTIALS_BASE64=

# S3 (업로드 모듈 구현 전이라도 미리 채워둠)
AWS_ACCESS_KEY=your_iam_access_key
AWS_SECRET_KEY=your_iam_secret_key
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=chunghaha-storage
